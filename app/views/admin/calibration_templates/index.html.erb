<% content_for :head do %>
  <%= append_stylesheet_pack_tag "selectize" %>
  <%= append_javascript_pack_tag "stimulus" %>
  <%= append_javascript_pack_tag "selectize" %>
  <%= append_javascript_pack_tag "try_calculate" %>
<% end %>

<% content_for :action_bar do %>
  <ol>
    <li class="action_bar-item">
      <%= link_to new_admin_company_evaluation_calibration_template_path(company_evaluation_id: @company_evaluation.id), class: "btn btn-outline-primary", data: {controller: "modal", action: "modal#click", "modal-page-reload-value": true} do %>
        <%= t("form.new") %> <%= svg_icon("free.svg#cil-plus", %w[icon]) %>
      <% end %>
    </li>
    <li class="action_bar-item">
      <%= link_to admin_company_evaluation_templates_path(company_evaluation_id: @company_evaluation.id), class: "btn btn-outline-primary" do %>
        <%= t("admin.evaluation_templates.index.title") %>
      <% end %>
    </li>
  </ol>
<% end %>

<div class="row justify-content-center">
  <div class="col-lg-12">
    <div class="container">
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th><%= t(".template_name") %></th>
            <th><%= t(".company_evaluation_templates") %></th>
            <th><%= t(".staff_distribution") %></th>
            <th><%= t(".manager_distribution") %></th>
            <th><%= t(".enforcement") %></th>
            <th><%= t("form.action") %></th>
          </tr>
        </thead>
        <tbody>
          <% @calibration_templates.each do |calibration_template| %>
            <tr>
              <td><%= calibration_template.template_name %></td>
              <td>
                <% calibration_template.company_evaluation_templates.select { |template| template.company_evaluation_id == @company_evaluation.id }.each do |template| %>
                  <div><%= template.title %></div>
                <% end %>
              </td>
              <td>
                <%= t("calibration.apa_grade") %>: <%= calibration_template.apa_grade_rate %>%<br>
                <%= t("calibration.b_grade") %>: <%= calibration_template.b_grade_rate %>%<br>
                <%= t("calibration.cd_grade") %>: <%= calibration_template.cd_grade_rate %>%
              </td>
              <td>
                <%= t("calibration.beyond_standard_rate") %>: <%= calibration_template.beyond_standard_rate %>%<br>
                <%= t("calibration.standards_compliant_rate") %>: <%= calibration_template.standards_compliant_rate %>%<br>
                <%= t("calibration.below_standard_rate") %>: <%= calibration_template.below_standard_rate %>%
              </td>
              <td>
                <% if calibration_template.enforce_distribute? %>
                  <%= calibration_template.enforce_highest_only? ? t(".highest_only") : t(".all_grades") %>
                <% else %>
                  <%= t(".not_enforced") %>
                <% end %>
              </td>
              <td>
                <%= link_to edit_admin_company_evaluation_calibration_template_path(id: calibration_template.id, company_evaluation_id: @company_evaluation.id), data: {controller: "modal", action: "modal#click", "modal-page-reload-value": true} do %>
                  <%= svg_icon("free.svg#cil-pen", %w[icon icon-lg]) %>
                <% end %>
                <% if calibration_template.calibration_sessions.blank? %>
                  <%= link_to confirm_destroy_admin_company_evaluation_calibration_template_path(id: calibration_template.id, company_evaluation_id: @company_evaluation.id), data: {controller: "modal", action: "modal#click", "modal-page-reload-value": true} do %>
                    <%= svg_icon("free.svg#cil-delete", %w[icon icon-lg]) %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
